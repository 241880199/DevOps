# Byte-for-byte referenced samples: keep LF on every host so the recorded digests stay true.
fixtures/detection/**/*.json text eol=lf
# Fixture files are byte-for-byte referenced (SHA-256 in artifact samples) and consumed
# inside Linux containers; without this their bytes depend on the host's core.autocrlf.
fixtures/draft/** text eol=lf
fixtures/mdfixer/** text eol=lf
contracts/samples/artifact.actual-graph-*.json text eol=lf
contracts/samples/artifact.declared-graph-*.json text eol=lf
contracts/samples/artifact.error-report-*.json text eol=lf

# Linux course fixtures and scripts must remain executable as text on Windows checkouts.
fixtures/md-rd/** text eol=lf
fixtures/commits/** text eol=lf
services/** text eol=lf
scripts/*.py text eol=lf
scripts/**/*.py text eol=lf
Makefile text eol=lf
compose.yaml text eol=lf
requirements-dev.* text eol=lf
evidence/**/*.log text eol=lf
evidence/**/*.json text eol=lf
evidence/** text eol=lf
evidence/**/*.bundle -text
.env.example text eol=lf
.dockerignore text eol=lf
