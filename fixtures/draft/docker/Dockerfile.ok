# 参考成功样例：能构建出可运行镜像的 Dockerfile。
# 这是 DRAFT 应当产出的目标形态，用作本地基线。
#
#   构建：docker build -f fixtures/draft/docker/Dockerfile.ok -t draft-fixture-ok fixtures/draft
#   验证：docker run --rm draft-fixture-ok        # 预期输出 hello draft

FROM ubuntu:22.04

WORKDIR /work
COPY main.c Makefile ./

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/* \
 && make

CMD ["./hello"]
