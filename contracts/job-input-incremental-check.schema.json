{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-course.local/schemas/job-input-incremental-check.schema.json",
  "title": "IncrementalCheckJobInput",
  "description": "INCREMENTAL_CHECK 的 A03 接口提案。任务以 artifact_id 引用 BuildChecker 的基线实际图，并以 environment_id 判断执行环境是否可比。",
  "type": "object",
  "required": ["base_commit", "repository", "baseline", "environment_id"],
  "additionalProperties": false,
  "properties": {
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": {
      "type": "object",
      "required": ["url", "canonical_url", "commit"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "canonical_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[^?#]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["actual_graph_artifact_id", "commit", "environment_id"],
      "additionalProperties": false,
      "properties": {
        "actual_graph_artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "通过 GET /v1/artifacts/{artifact_id} 下载的 BuildChecker 基线实际图。"
        },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "environment_id": { "type": "string", "pattern": "^env-[A-Za-z0-9_-]+$" }
      }
    },
    "environment_id": { "type": "string", "pattern": "^env-[A-Za-z0-9_-]+$" },
    "limits": {
      "type": "object",
      "required": ["timeout_seconds"],
      "additionalProperties": false,
      "properties": { "timeout_seconds": { "type": "integer", "minimum": 1 } }
    }
  }
}
