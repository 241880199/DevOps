{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-course.local/schemas/job-input-full-check.schema.json",
  "title": "FullCheckJobInput",
  "description": "FULL_CHECK 的 接口提案。按照 contract-phase 公共约定，任务只引用 environment_id；镜像、项目根目录与构建命令由 Environment Provider 保存。",
  "type": "object",
  "required": ["repository", "environment_id"],
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "object",
      "required": ["url", "canonical_url", "commit"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "canonical_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[^?#]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "environment_id": {
      "type": "string",
      "pattern": "^env-[A-Za-z0-9_-]+$",
      "description": "平台全局唯一的环境身份；完整环境定义由 Environment Provider 提供。"
    },
    "limits": {
      "type": "object",
      "required": ["timeout_seconds"],
      "additionalProperties": false,
      "properties": { "timeout_seconds": { "type": "integer", "minimum": 1 } }
    }
  }
}
