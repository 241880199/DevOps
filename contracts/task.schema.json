{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-course.local/schemas/task.schema.json",
  "title": "Task",
  "description": "统一任务模型。一份 Job 表达四类耗时任务：DRAFT / FULL_CHECK / INCREMENTAL_CHECK / REPAIR。公共字段对四类任务完全一致，input 与 output 的具体结构由 job_type 决定。",
  "type": "object",
  "required": ["schema_version", "job_id", "job_type", "status", "execution"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0",
      "description": "Job 契约版本。contract-phase 公共结构迁移属于破坏性变更，当前为 2.0。"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[A-Za-z0-9_-]+$",
      "description": "任务编号，由服务端产生，创建请求中不得携带。"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "description": "串联同一次平台流程的追踪号。可选；由调用方透传，缺失时服务端自行生成。"
    },
    "job_type": {
      "type": "string",
      "enum": ["DRAFT", "FULL_CHECK", "INCREMENTAL_CHECK", "REPAIR"],
      "description": "任务种类。未知取值必须被拒绝，由 validate.py 校验。"
    },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED"],
      "description": "QUEUED 已受理 / RUNNING 后台执行 / SUCCEEDED 结果可用 / 其余为终态。"
    },
    "execution": {
      "type": "object",
      "description": "任务级执行元数据，始终存在；尚未发生的时间取 null。",
      "required": ["created_at", "started_at", "finished_at", "attempt"],
      "additionalProperties": false,
      "properties": {
        "created_at": { "type": "string", "format": "date-time", "pattern": "\\.[0-9]{3}Z$" },
        "started_at": { "type": ["string", "null"], "format": "date-time", "pattern": "\\.[0-9]{3}Z$" },
        "finished_at": { "type": ["string", "null"], "format": "date-time", "pattern": "\\.[0-9]{3}Z$" },
        "attempt": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "description": "任务输入。job_type=DRAFT 时必须符合 job-input-draft.schema.json。"
    },
    "output": {
      "type": "object",
      "description": "任务产物引用。仅在终态出现：status=SUCCEEDED 时必填，QUEUED/RUNNING 时不得携带。job_type=DRAFT 时必须符合 job-output-draft.schema.json。"
    },
    "error": {
      "$ref": "#/$defs/error",
      "description": "系统执行错误。status 为 FAILED / TIMED_OUT / CANCELLED 时必填。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUCCEEDED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["output"],
        "not": { "required": ["error"] },
        "description": "成功与失败语义互斥：SUCCEEDED 不得携带 error。"
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["FAILED", "TIMED_OUT", "CANCELLED"] }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["error"],
        "not": { "required": ["output"] },
        "description": "失败终态只交付失败原因，不得同时携带成功产出。"
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["QUEUED", "RUNNING"] } },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["error"] }, { "required": ["output"] }]
        },
        "description": "output 与 error 都是终态的产物：未结束的任务不得携带二者。"
      }
    },
    {
      "if": { "properties": { "status": { "const": "QUEUED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at": { "const": null },
              "finished_at": { "const": null },
              "attempt": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "RUNNING" } }, "required": ["status"] },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at": { "type": "string" },
              "finished_at": { "const": null },
              "attempt": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["SUCCEEDED", "FAILED", "TIMED_OUT"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "started_at": { "type": "string" },
              "finished_at": { "type": "string" },
              "attempt": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "CANCELLED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "execution": {
            "properties": { "finished_at": { "type": "string" } },
            "oneOf": [
              {
                "properties": {
                  "started_at": { "const": null },
                  "attempt": { "const": 0 }
                }
              },
              {
                "properties": {
                  "started_at": { "type": "string" },
                  "attempt": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "description": "系统执行错误。注意：正常分析发现（MD/RD 等）不写这里，见 contracts/error-codes.md。",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": ["ENV_3002", "EXEC_4002", "ANALYSIS_5001", "REPAIR_6001", "REPAIR_6002"],
          "description": "contract-phase 已共同定义的任务错误码。新增错误码必须先同步共享文档和本约束。"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "人类可读的错误摘要。"
        },
        "stage": {
          "type": "string",
          "enum": ["ENV", "EXEC", "ANALYSIS", "REPAIR"]
        },
        "detail": {
          "type": "string",
          "description": "补充说明，例如容器内命令与退出码。"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "\\.[0-9]{3}Z$"
        }
      }
    }
  }
}
